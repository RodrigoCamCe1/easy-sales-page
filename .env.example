# Flutter client configuration (desktop app)
# Keep only client-side settings here.

# La API key de OpenAI debe ir en el BACKEND (backend/.env → OPENAI_API_KEY).
# Este valor solo se usa como fallback si el backend no está disponible (dev local sin servidor).
OPENAI_API_KEY=
BACKEND_API_URL=http://localhost:4000
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
SYSTEM_PROMPT=Eres un agente de IA que ayuda a responder de forma clara y breve.

WINDOWS_AUDIO_BACKEND=dshow
WINDOWS_AUDIO_DEVICE=Stereo Mix (Realtek(R) Audio)
WINDOWS_MIC_DEVICE=Microphone Array (Realtek(R) Audio)
WINDOWS_AUDIO_SAMPLE_RATE=48000

OPENAI_VAD_SILENCE_MS=1000
OPENAI_REALTIME_FLUSH_SECONDS=6
